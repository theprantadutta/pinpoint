<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_note"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/widget_new_note"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shortcut_note"
        android:tint="@color/widget_ink" />
    <ImageView
        android:id="@+id/widget_checklist"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/widget_checklist"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shortcut_checklist"
        android:tint="@color/widget_ink" />
    <ImageView
        android:id="@+id/widget_voice"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/widget_voice"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shortcut_voice"
        android:tint="@color/widget_ink" />
</LinearLayout>
